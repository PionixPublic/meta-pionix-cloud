[Unit]
Description=Pionix Cloud Connector
Documentation=https://pionix.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloud-connector
Group=cloud-connector
# Substituted at build time (see cloudconnector-install.bbclass).
@SUPPLEMENTARY_GROUPS_BLOCK@
@STATE_DIRECTORY_BLOCK@
ExecStart=@CC_DIRECTORY@/cloud-connector --config @CC_CONFIG_PATH@
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloud-connector

[Install]
WantedBy=multi-user.target
