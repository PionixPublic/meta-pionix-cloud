[Unit]
Description=Pionix Cloud Connector
Documentation=https://pionix.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudconnector
Group=cloudconnector
# Substituted at build time (see cloudconnector-install.bbclass).
@SUPPLEMENTARY_GROUPS_BLOCK@
@STATE_DIRECTORY_BLOCK@
ExecStart=@CC_DIRECTORY@/cloudconnector --config @CC_CONFIG_PATH@
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloudconnector

[Install]
WantedBy=multi-user.target
